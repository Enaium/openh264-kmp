headers = openh264_kmp.h
compilerOpts = -std=c11
# Kotlin/Native already links the C++ runtime for every target (libc++ on Apple,
# libstdc++ on Linux/MinGW, libc++_static on Android), so the shim only asks
# for the maths and threading libraries OpenH264's decoder uses.
linkerOpts.linux_x64 = -lm -lpthread
linkerOpts.linux_arm64 = -lm -lpthread
linkerOpts.mingw_x64 = -lm
linkerOpts.macos_x64 = -lm
linkerOpts.macos_arm64 = -lm
linkerOpts.ios_arm64 = -lm
linkerOpts.ios_x64 = -lm
linkerOpts.ios_simulator_arm64 = -lm
linkerOpts.tvos_arm64 = -lm
linkerOpts.tvos_simulator_arm64 = -lm
linkerOpts.watchos_arm64 = -lm
linkerOpts.watchos_simulator_arm64 = -lm
linkerOpts.watchos_device_arm64 = -lm
linkerOpts.android_arm64 = -lm
linkerOpts.android_arm32 = -lm
linkerOpts.android_x64 = -lm
linkerOpts.android_x86 = -lm
